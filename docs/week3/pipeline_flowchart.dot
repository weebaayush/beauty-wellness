digraph pipeline {
  graph [rankdir=TB, fontname="Helvetica", nodesep=0.25, ranksep=0.22, bgcolor="white", pad=0.2];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, color="#1a1a1a", fillcolor="white", penwidth=1.2, width=4.6];
  edge  [color="#1a1a1a", arrowsize=0.7];

  raw   [label=<<b>RAW DATA</b><br/><font point-size="8">product_info.csv  +  reviews_*.csv  ·  configs/cleaning.yaml</font>>, fillcolor="#1a1a1a", fontcolor="white"];
  s1 [label=<<b>1. Ingest &amp; schema check</b><br/><font point-size="8">required columns present? → fail fast</font>>];
  s2 [label=<<b>2. Standardise formats</b><br/><font point-size="8">prices, sizes → mL, dates (4 formats), labels via mapping tables, brand keys</font>>];
  s3 [label=<<b>3. Validity rules</b><br/><font point-size="8">rating 1–5, price $1–$1,000, dates ≤ snapshot, counts add up, conflict flags</font>>];
  s4 [label=<<b>4. Duplicates &amp; referential integrity</b><br/><font point-size="8">exact + syndicated reviews, duplicate products, orphan reviews</font>>];
  s5 [label=<<b>5. Text &amp; ingredient cleaning</b><br/><font point-size="8">mojibake, HTML, URLs, PII scrub, language/incentive flags · INCI parsing &amp; synonyms</font>>];
  s6 [label=<<b>6. Missing values</b><br/><font point-size="8">recover → impute by group → 'unknown' + indicator → never impute targets</font>>];
  s7 [label=<<b>7. Outliers</b><br/><font point-size="8">domain bounds · robust z within category (log) · IQR · winsorise model copy</font>>];
  s8 [label=<<b>8. Feature engineering</b><br/><font point-size="8">price/mL, active &amp; fragrance flags, claims, skin_match, Bayesian rating, time</font>>];
  v  [label=<<b>Final validation</b><br/><font point-size="8">assertions: ranges, integrity, no duplicates, no PII</font>>, shape=diamond, width=3.2, height=0.9, fillcolor="#FFF1E8", color="#E8590C"];
  s9 [label=<<b>9. Normalise &amp; encode (scikit-learn)</b><br/><font point-size="8">time-based split → fit on train only: log1p + RobustScaler, StandardScaler, MinMax, One-Hot</font>>];
  out [label=<<b>OUTPUTS</b><br/><font point-size="8">reviews_clean · products_clean · X/y train-test · preprocessor.pkl · cleaning_log · quality report</font>>, fillcolor="#E8590C", fontcolor="white", color="#E8590C"];
  fail [label="stop & report", shape=box, style="rounded,dashed", width=1.3, fontsize=9, color="#6b6b6b", fontcolor="#6b6b6b"];
  logn [label=<<b>Cleaning log</b><br/><font point-size="8">every action +<br/>rows affected</font>>, shape=note, width=1.4, fontsize=9, color="#6b6b6b", fontcolor="#1a1a1a"];

  raw -> s1 -> s2 -> s3 -> s4 -> s5 -> s6 -> s7 -> s8 -> v;
  v -> s9 [label="  pass", fontsize=8, fontcolor="#6b6b6b"];
  v -> fail [label=" fail", fontsize=8, fontcolor="#6b6b6b", style=dashed];
  s9 -> out;
  {rank=same; v; fail}
  {rank=same; s4; logn}
  s4 -> logn [style=dotted, arrowhead=none, color="#6b6b6b"];
}
